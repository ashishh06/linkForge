# Copy to `.env` for local runs. Never commit `.env`.
# These are the defaults baked into application.yml, listed here so a fresh
# clone can see every setting the app reads.

DB_URL=jdbc:postgresql://localhost:5432/linkforge
DB_USER=linkforge
DB_PASSWORD=linkforge
DB_POOL_SIZE=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

PORT=8080
BASE_URL=http://localhost:8080

# HS256 requires at least 32 bytes. Generate one with:
#   openssl rand -base64 48
# The value in application.yml is a development fallback only; set this in any
# deployed environment.
JWT_SECRET=change-me-to-a-random-32-byte-secret
JWT_ISSUER=linkforge
JWT_ACCESS_TTL=15m
